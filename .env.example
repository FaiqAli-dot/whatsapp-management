# Copy to .env and adjust. Never commit real secrets.

NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/wrs_dev

# Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32
CREDENTIAL_ENCRYPTION_KEY=change-me-to-another-long-random-32+

CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
TRUST_PROXY=false
LOG_LEVEL=info

# simulator | meta
WHATSAPP_MODE=simulator
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=dev-verify-token
META_EMBEDDED_SIGNUP_CONFIG_ID=

# optional LLM drafts
OPENAI_API_KEY=

# test | stripe
BILLING_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# console | smtp
EMAIL_MODE=console
SMTP_URL=
